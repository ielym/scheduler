{
  "schema_version": 2,
  "name": "sample_task",
  "description": "示例任务：演示 SDK 托管断点续跑（可抢占）、心跳、错误分类与交付物校验。",
  "entry": {
    "file": "run.py",
    "interpreter": "python3",
    "args": [],
    "cwd": "."
  },
  "schedule": {
    "type": "manual",
    "max_instances": 1,
    "overflow": "queue"
  },
  "priority": 50,
  "env": {},
  "outputs": {
    "expect": ["results/final.json"]
  },
  "resources": {
    "cpu": 0.1,
    "memory_mb": 64,
    "soft": {}
  },
  "error_rules": {
    "resource_regex": [],
    "logic_regex": []
  },
  "heartbeat": {
    "timeout_sec": 120
  },
  "smoke": {
    "mode": "dry",
    "max_runtime_sec": 60
  },
  "runtime": {
    "user": "sched-run"
  },
  "contract_exempt": false
}